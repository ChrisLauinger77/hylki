[Desktop Entry]
Name=Vireo
GenericName=Email Client
Comment=A clean, fast GNOME-native email client
# %U, not %u: a file manager hands every selected file to one launch, so
# they all land in the same message ("Send with Vireo" from GNOME Files).
Exec=vireo %U
Icon=co.hyprlab.Vireo
Terminal=false
Type=Application
Categories=GNOME;GTK;Network;Email;
Keywords=Email;Mail;IMAP;
MimeType=x-scheme-handler/mailto;x-scheme-handler/mid;
StartupNotify=true
StartupWMClass=co.hyprlab.Vireo
